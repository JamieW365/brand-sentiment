# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Environment
.env
*.env.local

# Poetry
poetry.lock   # commit this — remove line if you want to exclude

# Data (never commit raw data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# MLFlow
mlruns/
mlflow.db

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# Logs
*.log
logs/

# Pytest
.pytest_cache/
.coverage
htmlcov/
